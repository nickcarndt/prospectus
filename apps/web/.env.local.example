# Required — browser → FastAPI (retrieval, budget reserve).
# The web app throws if this is missing (no silent localhost fallback).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js server → FastAPI (/ground). Defaults to NEXT_PUBLIC_API_URL if unset.
PROSPECTUS_API_URL=http://localhost:8000

# Required for streamed cited answers (Vercel AI SDK route /api/answer).
# Server-only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional overrides (defaults match the Python API)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=1024
